ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
LIVE_TRADING=false
RISK_PER_TRADE=0.02
MAX_POSITIONS=10
SCAN_INTERVAL_MINUTES=15

# Stop-loss: sell if position drops more than this (0.05 = 5%)
STOP_LOSS_PCT=0.05

# Email alerts (use a Gmail App Password, not your regular password)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
ALERT_EMAIL=ciancagliniantonio@gmail.com

# Sector filter: comma-separated sectors to trade, leave empty to trade all
# Example: technology,healthcare,financial services
ALLOWED_SECTORS=
